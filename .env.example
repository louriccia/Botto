# Copy to .env. Every name the bot reads; values are never committed.

# Discord
token=
clientId=
DISCORD_CLIENT_SECRET=

# Chance Cube API (src/api). Sign-in answers 503 until the first three are set.
# CUBE_JWT_SECRET must differ between local and production, or scripts/cubeDevToken.js can mint
# production sessions.
CUBE_JWT_SECRET=
# The browser sign-in's callback, registered as a Redirect URI on the Discord application.
# Production: https://botto-swe1r.herokuapp.com/cube/auth/callback
CUBE_OAUTH_REDIRECT=http://localhost:3030/cube/auth/callback
# Comma-separated sites allowed to receive a session. Production: https://bottosjunkyard.com
CUBE_SITE_ORIGINS=http://localhost:5173
# production turns off the sandbox routes and localhost origins.
NODE_ENV=
PORT=3030

# Firebase Realtime Database (firebase-admin)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# botto-api
BOTTO_API_BASE_URL=
BOT_API_KEY=
ENABLE_SSE=
SSE_REACT_WEBSITE=
SSE_REACT_MOD=

# Everything else
ENABLE_CRON=
SCAVENGER=
OPENAI_API_KEY=
PAPERTRAIL_KEY=
TWITCH_ID=
TWITCH_SECRET=
YOUTUBE_KEY=
